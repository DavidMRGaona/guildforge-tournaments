# The core's configuration (Larastan, level 8) over this module. Run from the core's src/:
#   vendor/bin/phpstan analyse -c modules/tournaments/phpstan.neon
includes:
    - ../../phpstan.neon

parameters:
    # Replace the core's paths (app/) instead of adding to them
    paths!:
        - src
        - tests
    # The module's tables live in its own migrations, next to the core's
    databaseMigrationsPath:
        - ../../database/migrations
        - database/migrations
    # The core's ignore is for traits of app/; reporting it unmatched here would be noise
    ignoreErrors!: []
    # Classes outside the module autoloader: seeders (the core requires them) and the test
    # helpers (mapped by tests/bootstrap.php, which PHPStan does not run)
    scanDirectories:
        - database/seeders
        - tests/Support
